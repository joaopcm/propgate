{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "NEXT_PUBLIC_API_URL", "PORT", "SENTRY_DSN"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "env": [
        "NODE_ENV",
        "PROPGATE_FIXTURES",
        "PROPGATE_FIXTURE_ROOT",
        "PROPGATE_FIXTURE_AUTH",
        "PROPGATE_FIXTURE_DECOY",
        "PROPGATE_FIXTURE_RESOLVER",
        "PROPGATE_FIXTURE_PERMISSIVE",
        "PROPGATE_FIXTURE_DIVERGENT",
        "PROPGATE_FIXTURE_PORT_OFFSET"
      ]
    }
  }
}
