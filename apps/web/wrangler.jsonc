{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propgate-web",
  "compatibility_date": "2026-01-01",
  "main": "./worker.ts",
  "routes": [{ "pattern": "propgate.dev", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
