// Static assets on Cloudflare Workers. No `main`: there is no Worker
// script, only the prerendered output, so requests never invoke compute.
//
//   pnpm --filter @propgate/web deploy:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propgate-web",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
