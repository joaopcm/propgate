// Static pages in `out/`, plus a Worker for the request-time behaviour a
// file cannot do: Accept negotiation, a markdown 404 body, and JSON errors
// on unknown `/v1/*` paths. Pages still prerender; the Worker only decides
// which file (or error) to return.
//
//   pnpm --filter @propgate/docs deploy:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propgate-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  // The custom domain, declared here rather than clicked in the dashboard.
  // Cloudflare creates and maintains the DNS record for it, so this is the only
  // place the hostname is written down. Requires the zone to already be on
  // Cloudflare; without that the deploy fails loudly rather than publishing to
  // a workers.dev URL nobody is looking at.
  "routes": [{ "pattern": "docs.propgate.dev", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
