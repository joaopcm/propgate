# dns-divergent — serves a second, deliberately different copy of a subset of
# zones.
#
# Real GeoDNS and anycast are not reproducible locally, but divergent *answers*
# are, and divergent answers are what the consensus and hysteresis logic
# actually consumes. Without this there is no way to test the property the
# README calls non-negotiable: that a single disagreeing vantage point must not
# produce domain.failed.
server:
  ip-address: @BIND_ADDRESS@
  port: @DNS_PORT@
  do-ip6: no
  server-count: 1
  zonesdir: "/"
  username: ""
  logfile: ""
  verbosity: 2
  hide-version: yes
  ipv4-edns-size: 1232
