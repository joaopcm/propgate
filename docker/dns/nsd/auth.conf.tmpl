# dns-auth — authoritative for every *.test child fixture zone, plus the
# realistic multi-label PSL zones (example.co.uk, user.github.io) which cannot
# live under .test because .test gets the PSL's implicit "*" rule.
server:
  ip-address: @BIND_ADDRESS@
  port: @DNS_PORT@
  do-ip6: no
  server-count: 1
  zonesdir: "/"
  username: ""
  logfile: ""
  verbosity: 2
  hide-version: yes
  ipv4-edns-size: 1232
