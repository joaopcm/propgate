# Copy to `.env` on the VPS, next to docker-compose.prod.yml.
#
# Compose reads this file automatically. Nothing here is baked into an image, so
# rotating a value is `docker compose up -d`, not a rebuild.

# Postgres. Generate with `openssl rand -base64 32`. The database is not
# published outside the compose network, but a weak password here is still the
# thing standing between a container escape and every tenant's data.
POSTGRES_PASSWORD=

# Only used by the Caddy overlay: the hostname it requests a certificate for.
# Must already resolve to this box — Let's Encrypt validates over HTTP, so a
# wrong record is a failed deploy rather than a slow one. On a platform that
# runs its own proxy this is unused; the hostname lives there instead.
API_DOMAIN=api.propgate.dev

# Where Postgres is published so a GUI client can reach it. Loopback by default,
# which means "tunnel to it" — nothing outside this machine can connect. A
# Tailscale address (`tailscale ip -4`) reaches it from your other machines
# without a tunnel. Never 0.0.0.0: scanners sweep 5432 continuously.
DB_BIND_ADDRESS=127.0.0.1

# The host port for that. Change it if something already owns 5432 on this box,
# which is common wherever a PaaS is running. Nothing inside the stack notices:
# the API reaches Postgres over the compose network, not the host.
DB_BIND_PORT=5432

# The sweeper. Every one of these is a default that has not been measured yet —
# the code says so at each definition, with what would earn the receipt. Leave
# them unset unless you have a reason.
#
#   SWEEP_TICK_SECONDS=60      how often to look for due domains
#   SWEEP_BATCH_SIZE=100       domains claimed per tick
#   SWEEP_LEASE_SECONDS=300    how long a claim is held; must exceed the 10s budget
#   CHECK_CONCURRENCY=4        parallel checks; multiplies load on other people's
#                              authoritative servers, so raise it deliberately

# Queue admin (Workbench). Leave both blank and the dashboard is not mounted at
# all — it is a pre-1.0 dependency, so a box that never looks at its queues
# should not be running it. Set them and it appears on WORKBENCH_BIND_PORT.
WORKBENCH_USER=
WORKBENCH_PASS=

# Where the dashboard is published. Loopback by default, exactly like the
# database above: reaching it means an SSH tunnel or a tailnet address
# (`tailscale ip -4`). Never 0.0.0.0 — basic auth is the only thing in front of
# something that can retry and delete jobs.
WORKBENCH_BIND_ADDRESS=127.0.0.1
WORKBENCH_BIND_PORT=3002

# Which images to run. `latest` follows main; a commit sha pins a rollback.
TAG=latest

# Only needed if this box is not deploying from the propgate repository.
GITHUB_REPOSITORY=joaopcm/propgate

# Optional. instrument.ts is a no-op when this is unset, so leaving it blank is
# a supported way to run.
SENTRY_DSN=
