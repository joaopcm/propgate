# Copy to `.env` on the VPS, next to docker-compose.prod.yml.
#
# Compose reads this file automatically. Nothing here is baked into an image, so
# rotating a value is `docker compose up -d`, not a rebuild.

# Postgres. Generate with `openssl rand -base64 32`. The database is not
# published outside the compose network, but a weak password here is still the
# thing standing between a container escape and every tenant's data.
POSTGRES_PASSWORD=

# Only used by the Caddy overlay: the hostname it requests a certificate for.
# Must already resolve to this box — Let's Encrypt validates over HTTP, so a
# wrong record is a failed deploy rather than a slow one. On a platform that
# runs its own proxy this is unused; the hostname lives there instead.
API_DOMAIN=api.propgate.dev

# Only read by the docker-compose.localdb.yml overlay: where to publish Postgres
# so a GUI client can reach it. Loopback by default, which means "tunnel to it".
# A Tailscale address (`tailscale ip -4`) exposes it to your tailnet instead.
# Never 0.0.0.0 — scanners sweep 5432 continuously.
DB_BIND_ADDRESS=127.0.0.1

# The host port for that. Change it if something already owns 5432 on this box,
# which is common wherever a PaaS is running. The container is unaffected.
DB_BIND_PORT=5432

# Which images to run. `latest` follows main; a commit sha pins a rollback.
TAG=latest

# Only needed if this box is not deploying from the propgate repository.
GITHUB_REPOSITORY=joaopcm/propgate

# Optional. instrument.ts is a no-op when this is unset, so leaving it blank is
# a supported way to run.
SENTRY_DSN=
