; NS_PARENT_CHILD_MISMATCH.
;
; test.zone delegates this to ns1 alone. The zone itself claims ns1 and
; ns-decoy. Resolvers follow the parent, so ns-decoy receives no traffic at all
; — the operator believes they have two nameservers and has one.
$ORIGIN mismatch.test.
$TTL 300

@       IN SOA  ns1.test. hostmaster.propgate.invalid. (
                1 7200 3600 1209600 300 )
@       IN NS   ns1.test.
@       IN NS   ns-decoy.test.
