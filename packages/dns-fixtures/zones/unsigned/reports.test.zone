; An external report destination that HAS authorised dmarc.test.
;
; RFC 7489 7.1: to accept reports for another domain, the destination publishes
; <source>._report._dmarc.<destination> containing a DMARC record.
$ORIGIN reports.test.
$TTL 300

@       IN SOA  ns1.test. hostmaster.propgate.invalid. (
                1 7200 3600 1209600 300 )
@       IN NS   ns1.test.

dmarc.test._report._dmarc   IN TXT  "v=DMARC1"
